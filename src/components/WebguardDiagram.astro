---
// Built only from the facts in DESIGN.md section 7.3. It shows the planned design, not a working system.
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<figure class:list={['diagram', { 'diagram--compact': compact }]}>
  <div class="diagram__flow">
    <ul class="col">
      <li><b>NVD</b>{!compact && <span>records as inputs</span>}</li>
      <li><b>Exploit-DB</b>{!compact && <span>public-exploit availability</span>}</li>
      <li><b>CISA KEV</b>{!compact && <span>the label</span>}</li>
    </ul>
    <span class="arrow" aria-hidden="true"></span>
    <div class="box">
      {
        compact ? (
          <b>Four models compared</b>
        ) : (
          <>
            <b>Models compared</b>
            <span>Logistic Regression, Decision Tree, Random Forest, XGBoost</span>
            <span>Time-aware split, PR-AUC</span>
          </>
        )
      }
    </div>
    <span class="arrow" aria-hidden="true"></span>
    <div class="box box--out">
      <b>Probability of exploitation</b>
      {!compact && <span>EPSS is the benchmark to beat, not an input</span>}
    </div>
  </div>
  {
    !compact && (
      <figcaption>Planned design from the proposal. Nothing here is a working system yet.</figcaption>
    )
  }
</figure>

<style>
  .diagram {
    margin: 0;
  }

  .diagram--compact {
    height: 100%;
  }

  .diagram__flow {
    display: grid;
    gap: 0.6rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .diagram--compact .diagram__flow {
    height: 100%;
    grid-template-columns: 1fr auto 1fr auto 1fr;
    align-items: center;
    gap: 0.35rem;
    padding: 0.6rem;
    font-size: 0.6875rem;
  }

  .col {
    display: grid;
    gap: 0.4rem;
    list-style: none;
  }

  .col li,
  .box {
    display: grid;
    gap: 0.15rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 3px;
    background: var(--bg);
    color: var(--muted);
  }

  .diagram--compact .col li,
  .diagram--compact .box {
    padding: 0.35rem;
  }

  b {
    color: var(--text);
    font-weight: 500;
  }

  .box--out {
    border-color: var(--accent);
  }

  .arrow {
    justify-self: center;
    width: 1px;
    height: 1rem;
    background: var(--muted);
  }

  .diagram--compact .arrow {
    width: 0.5rem;
    height: 1px;
  }

  @container (min-width: 380px) {
    .diagram--compact .diagram__flow {
      gap: 0.5rem;
      padding: 1rem;
      font-size: 0.8125rem;
    }

    .diagram--compact .col li,
    .diagram--compact .box {
      padding: 0.5rem;
    }
  }

  figcaption {
    margin-top: 0.6rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  @media (min-width: 720px) {
    .diagram:not(.diagram--compact) .diagram__flow {
      grid-template-columns: 1.2fr auto 1.2fr auto 1fr;
      align-items: center;
    }

    .arrow {
      width: 1rem;
      height: 1px;
    }
  }
</style>
