---
// Without JavaScript the dim letters are CSS generated content, which stays out of the page's
// text. With it, one canvas keeps them changing and another draws the bright streams on top.
import { LETTER_WORDS, letterRows, symbolRows } from '../lib/letters';

interface Props {
  symbols?: boolean;
}

const { symbols = false } = Astro.props;
---

<div
  class="letters"
  data-letters={symbols ? symbolRows() : letterRows()}
  data-words={symbols ? undefined : LETTER_WORDS.join(',')}
  aria-hidden="true"
>
  <canvas data-letter-dim></canvas>
  <canvas data-letter-canvas></canvas>
</div>

<style>
  .letters {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    line-height: 20px;
    pointer-events: none;
    user-select: none;
  }

  .letters::before {
    content: attr(data-letters);
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0.1;
    white-space: pre;
  }

  /* Once the script runs, a canvas takes over so the characters can keep changing. */
  .letters.is-live::before {
    display: none;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
