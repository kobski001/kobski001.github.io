---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import WebguardDiagram from '../../components/WebguardDiagram.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const {
  title,
  summary,
  status,
  problem,
  role,
  credit,
  stack,
  limitations,
  repo,
  demo,
  paper,
  linksNote,
  diagram,
  screenshots,
} = project.data;

const pageTitle = status === 'research' ? `${title} Research` : `${title} Project`;
const links = [
  { label: 'Repository', href: repo },
  { label: 'Live demo', href: demo },
  { label: 'Paper', href: paper },
].filter((link) => link.href);
---

<Base title={pageTitle} description={summary}>
  <article class="wrap">
    <header class="page-head">
      <p class="back"><a href={url('/work/')}>All work</a></p>
      <h1 translate="no">{title}</h1>
      <div class="status"><StatusBadge status={status} /></div>
    </header>

    <div class="rows">
      <section class="section__grid">
        <h2 class="label">Problem</h2>
        <div class="prose"><p>{problem}</p></div>
      </section>

      <section class="section__grid">
        <h2 class="label">My role</h2>
        <div class="prose">
          <p>{credit}.</p>
          <p>{role ?? <Placeholder text="[My role on WebGuard coming soon]" />}</p>
        </div>
      </section>

      <section class="section__grid">
        <h2 class="label">Stack</h2>
        <ul class="tags">{stack.map((item) => <li>{item}</li>)}</ul>
      </section>

      <section class="section__grid">
        <h2 class="label">{status === 'research' ? 'Current status' : 'Key results'}</h2>
        <div class="prose"><Content /></div>
      </section>

      <section class="section__grid">
        <h2 class="label">{diagram ? 'Planned design' : 'Screenshots'}</h2>
        <div class="shots">
          {diagram && <WebguardDiagram />}
          {
            screenshots.map((shot) => (
              <Image src={shot.src} alt={shot.alt} widths={[640, 960]} sizes="(min-width: 860px) 860px, 100vw" />
            ))
          }
          {
            !diagram && screenshots.length === 0 && (
              <Placeholder block text="[Screenshots coming soon]" ratio="16 / 9" />
            )
          }
        </div>
      </section>

      <section class="section__grid">
        <h2 class="label">Links</h2>
        <div class="prose">
          {linksNote && <p>{linksNote}</p>}
          {
            links.length > 0 && (
              <ul class="links">
                {links.map((link) => (
                  <li>
                    <a href={link.href}>{link.label}</a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </section>

      <section class="section__grid">
        <h2 class="label">Limitations</h2>
        <div class="prose">
          <ul>{limitations.map((item) => <li>{item}</li>)}</ul>
        </div>
      </section>
    </div>
  </article>
</Base>

<style>
  .back {
    margin: 0 0 1rem;
    font-size: 1rem;
  }

  .status {
    margin-top: 1rem;
  }

  .rows {
    display: grid;
    gap: 2.75rem;
    margin-top: 3rem;
  }

  .shots {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .shots :global(img) {
    width: 100%;
    border-radius: var(--radius);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    padding: 0;
    list-style: none;
  }

  .links li + li {
    margin-top: 0;
  }
</style>
