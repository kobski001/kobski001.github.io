---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

const offers = [
  { title: 'Websites', text: 'A site for your business, built to the pages and features you need.' },
  { title: 'Short product videos', text: 'Videos of 10 to 30 seconds that show what you sell.' },
  { title: 'Ad creatives', text: 'Visuals for your ads.' },
];

const steps = ['Discuss', 'Quote', 'Build', 'Revise', 'Deploy', 'Hand over'];
const contactHref = site.email ? `mailto:${site.email}` : url('/contact/');
---

<Base
  title="Small-Business Services"
  description="Websites, short product videos and ad creatives for small businesses. Message for a quote."
>
  <div class="wrap">
    <header class="page-head">
      <h1>Services for small businesses</h1>
      <p>I make websites, short product videos and ad creatives.</p>
    </header>

    <div class="rows">
      <section class="section__grid">
        <h2 class="label">What I offer</h2>
        <div class="offers">
          {
            offers.map(({ title, text }) => (
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section class="section__grid">
        <h2 class="label">How it works</h2>
        <ol class="steps">
          {
            steps.map((step) => <li>{step}</li>)
          }
        </ol>
      </section>

      <section class="section__grid">
        <h2 class="label">What’s included</h2>
        <div class="prose">
          <p>
            Before I start, we agree on the pages and features, the number of revisions and the
            deadline. A deposit is paid before work begins.
          </p>
          <p>You own your domain and hosting.</p>
        </div>
      </section>

      <section class="section__grid">
        <h2 class="label">Sample work</h2>
        <p>Coming soon.</p>
      </section>

      <section class="section__grid">
        <h2 class="label">Pricing</h2>
        <div class="cta">
          <p>Message me for a quote.</p>
          <a class="btn btn--primary" href={contactHref}>Message me</a>
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  .rows {
    display: grid;
    gap: 2.75rem;
    margin-top: 3rem;
  }

  .offers {
    display: grid;
    gap: 1.5rem;
  }

  h3 {
    margin-bottom: 0.35rem;
    font-size: 1.3rem;
  }

  .offers p {
    color: var(--muted);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.5rem;
    list-style: none;
  }

  .steps li {
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .cta {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  @media (min-width: 760px) {
    .offers,
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
