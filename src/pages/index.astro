---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Certification from '../components/Certification.astro';
import Chapter from '../components/Chapter.astro';
import ChapterRail from '../components/ChapterRail.astro';
import ContactLinks from '../components/ContactLinks.astro';
import LetterField from '../components/LetterField.astro';
import Photo from '../components/Photo.astro';
import Placeholder from '../components/Placeholder.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, skills } from '../data/site';
import { url } from '../lib/url';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const focusAreas = [
  {
    title: 'Security research with ML',
    text: 'SmishGuard detects smishing in Filipino and Taglish SMS. WebGuard is a proposal to predict which CVEs get exploited.',
  },
  {
    title: 'Security tooling',
    text: 'Panoptes combines passive OSINT on an IP address into one report, without sending packets to the target.',
  },
  {
    title: 'Systems and infrastructure',
    text: 'Docker, Kubernetes and a homelab.',
  },
];

const chapters = [
  { id: 'top', label: 'Intro' },
  { id: 'focus', label: 'Focus' },
  { id: 'projects', label: 'Projects' },
  { id: 'skills', label: 'Skills' },
  { id: 'credentials', label: 'Credentials' },
  { id: 'about', label: 'About' },
  { id: 'contact', label: 'Contact' },
];

const allSkills = skills.flatMap(({ items }) => items);
---

<Base
  title={site.displayName ? `${site.displayName} Portfolio` : 'Security Portfolio'}
  description="Portfolio of a computer science student heading into cybersecurity, with runnable security projects and honest notes on what is finished."
  intro
>
  <div class="intro" data-intro-screen>
    <div class="intro__line" aria-hidden="true">
      <span class="label">Loading</span>
      <span class="intro__bar"><span></span></span>
      <span class="intro__quote">Knowledge is a never-ending journey</span>
    </div>
    <button type="button" class="intro__skip" data-intro-skip>Skip intro</button>
  </div>

  <ChapterRail chapters={chapters} />

  <section class="hero" id="top" data-hero aria-labelledby="hero-heading">
    <LetterField />
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__wide hero__main">
      <div>
        <p class="hero__name rise">{site.displayName ?? '[Display name]'}</p>
        <h1 id="hero-heading">
          <span class="line"><span class="rise" style="--d: 0.05s">Know what you know.</span></span>{' '}
          <span class="line"><span class="rise" style="--d: 0.13s">Know what you don’t.</span></span>{' '}
          <span class="line"><span class="rise" style="--d: 0.21s">Return the truth</span></span>
        </h1>
      </div>
      <div class="hero__panel rise" style="--d: 0.4s">
        <p class="whoami">
          <span class="whoami__cmd">$ whoami</span>
          <span>cs student, heading into cybersecurity</span>
        </p>
        <div class="hero__foot">
          <p class="hero__lead">
            I’m a 3rd-year BS Computer Science student at De La Salle University–Dasmariñas. Each
            project here says what is finished and what is still in progress.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href="#projects">View projects</a>
            {
              site.cv && (
                <a class="btn btn--ghost" href={url(site.cv)} download>
                  Download CV
                </a>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <Chapter id="focus" title="What I work on">
    <ol class="focus">
      {
        focusAreas.map((area) => (
          <li data-reveal>
            <h3>{area.title}</h3>
            <p>{area.text}</p>
          </li>
        ))
      }
    </ol>
  </Chapter>

  <Chapter id="projects" title="Selected projects" stage>
    <div class="projects" data-stage>
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </Chapter>

  <Chapter id="skills" title="Skills">
    <dl class="skills">
      {
        skills.map(({ group, items }) => (
          <div data-reveal>
            <dt>{group}</dt>
            <dd>
              <ul class="tags">
                {items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
    <div class="marquee" aria-hidden="true">
      <div class="marquee__track">
        {[...allSkills, ...allSkills].map((item) => <span>{item}</span>)}
      </div>
    </div>
  </Chapter>

  <Chapter id="credentials" title="Certifications">
    <div data-reveal><Certification /></div>
  </Chapter>

  <Chapter id="about" title="About">
    <div class="about">
      <div class="about__photo" data-reveal><Photo /></div>
      <div class="prose" data-reveal>
        <p>
          I’m studying BS Computer Science at De La Salle University–Dasmariñas and heading toward
          cybersecurity. Networking, machine learning, data analysis and web development are my
          secondary options.
        </p>
        <p>{site.bio ?? <Placeholder text="[Bio coming soon]" />}</p>
        <p>{site.personalLine}</p>
        <p><a href={url('/about/')}>More about me</a></p>
      </div>
    </div>
  </Chapter>

  <Chapter id="contact" title="Contact">
    <div data-reveal><ContactLinks /></div>
  </Chapter>
</Base>

<script>
  import '../scripts/intro.ts';
  import '../scripts/chapters.ts';
  import '../scripts/hero.ts';
  import '../scripts/motion-gate.ts';
</script>

<style>
  .intro {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 50;
    background: var(--bg);
  }

  :global(:root[data-intro='on']) .intro,
  :global(:root[data-intro='out']) .intro {
    display: grid;
    place-items: center;
    animation: intro-out 0.5s 2.2s forwards;
  }

  :global(:root[data-intro='out']) .intro {
    animation: intro-out 0.5s forwards;
  }

  @keyframes intro-out {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  .intro__line {
    display: grid;
    gap: 0.6rem;
    width: min(26rem, 70vw);
  }

  .intro__bar {
    display: block;
    height: 2px;
    overflow: hidden;
    background: var(--border);
  }

  .intro__bar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--accent-2), var(--accent));
    transform-origin: left;
    animation: intro-fill 1.2s cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  .intro__quote {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  @keyframes intro-fill {
    from {
      transform: scaleX(0);
    }
  }

  .intro__skip {
    position: absolute;
    right: var(--gutter);
    bottom: 1.5rem;
    min-height: 44px;
    padding-inline: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: none;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .intro__skip:hover {
    color: var(--text);
  }

  .hero {
    /* Lets the link to this chapter land above the header, at the very top. */
    scroll-margin-top: 100px;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    min-height: calc(100svh - 58px);
    border-bottom: 1px solid var(--border);
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bg) 62%, transparent) 0%,
      color-mix(in srgb, var(--bg) 50%, transparent) 60%,
      transparent 100%
    );
  }

  .hero__wide {
    width: 100%;
    max-width: calc(var(--content) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .hero__main {
    display: grid;
    align-content: center;
    gap: 1.25rem;
    padding-block: clamp(1.5rem, 4vw, 2.75rem) 3rem;
  }

  .hero__name {
    width: fit-content;
    margin: 0 0 0.75rem -0.4em;
    padding: 0.1em 0.4em;
    background: var(--bg);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(3.4rem, 8.9vw, 8.25rem);
    font-stretch: 75%;
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    text-wrap: wrap;
  }

  .line {
    display: inline;
  }

  /* Small text sits on a solid panel, so the letters never run behind it. */
  .hero__panel {
    display: grid;
    gap: 1rem;
    justify-self: start;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .whoami {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--muted);
  }

  .whoami__cmd {
    color: var(--accent);
    margin-right: 0.5ch;
  }

  .hero__foot {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 34rem;
  }

  .hero__lead {
    color: var(--muted);
    font-size: 1.125rem;
  }

  /* Headline lines rise out of a mask. Plain CSS, so a script failure can't hide them. */
  .rise {
    animation: rise 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(0.1s + var(--d, 0s));
  }

  :global(:root[data-arrived]) .rise {
    animation: none;
  }

  :global(:root[data-intro='on']) .rise,
  :global(:root[data-intro='out']) .rise {
    animation-delay: calc(1.5s + var(--d, 0s));
  }

  /* Narrow screens wrap freely, so the lines fade instead of rising from a mask. */
  h1 .rise {
    animation-name: fade;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @keyframes rise-line {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @media (min-width: 640px) {
    .line {
      display: block;
      overflow: clip;
      overflow-clip-margin: 0.08em;
    }

    h1 .rise {
      display: inline-block;
      animation-name: rise-line;
    }
  }

  @media (min-width: 860px) {
    .hero__scrim {
      background: linear-gradient(
        100deg,
        color-mix(in srgb, var(--bg) 60%, transparent) 0%,
        color-mix(in srgb, var(--bg) 30%, transparent) 50%,
        transparent 78%
      );
    }

    .hero__main {
      padding-block-end: clamp(1.5rem, 3vw, 2.5rem);
    }

    .hero__foot {
      grid-template-columns: minmax(0, 34rem) auto;
      align-items: end;
      gap: 2rem;
      max-width: none;
    }

  }

  .focus {
    display: grid;
    gap: 1rem;
    list-style: none;
  }

  .focus li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .focus h3 {
    font-size: 1.4rem;
  }

  .focus p {
    color: var(--muted);
    font-size: 1rem;
  }

  @media (min-width: 760px) {
    .focus {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .projects {
    display: grid;
    gap: 1.25rem;
  }

  /* Set by the scroll layer on tall desktop screens. Otherwise this is a plain list. */
  .projects:global(.is-staged) :global(.card) {
    grid-area: 1 / 1;
    pointer-events: none;
  }

  .projects:global(.is-staged) :global(.card.is-active) {
    pointer-events: auto;
  }

  .skills {
    display: grid;
    gap: 1.25rem;
    margin: 0;
  }

  .skills dt {
    margin-bottom: 0.4rem;
    font-weight: 600;
  }

  .skills dd {
    margin: 0;
  }

  @media (min-width: 760px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.75rem 2rem;
    }
  }

  .marquee {
    overflow: hidden;
    margin-top: 2.5rem;
    border-block: 1px solid var(--border);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee__track {
    display: flex;
    gap: 2.5rem;
    width: max-content;
    padding-block: 0.75rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.875rem;
    animation: marquee 40s linear infinite;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  .about {
    display: grid;
    gap: 1.5rem;
  }

  .about__photo {
    max-width: 200px;
  }

  @media (min-width: 640px) {
    .about {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 2rem;
    }
  }
</style>
