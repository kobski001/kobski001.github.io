---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page Not Found" description="This page does not exist.">
  <div class="wrap">
    <header class="page-head">
      <h1>Page not found</h1>
      <p>This address doesn’t match any page. Check the link, or go to the home page.</p>
    </header>
    <p class="home"><a class="btn btn--primary" href={url('/')}>Go to the home page</a></p>
  </div>
</Base>

<style>
  .home {
    margin-top: 2rem;
  }
</style>
