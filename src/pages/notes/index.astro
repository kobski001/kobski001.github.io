---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/date';
import { url } from '../../lib/url';

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title="Notes and Write-ups" description="Write-ups on projects, labs and CTFs.">
  <div class="wrap">
    <header class="page-head">
      <h1>Notes</h1>
      {notes.length === 0 && <p>Write-ups on projects, labs and CTFs coming soon.</p>}
    </header>
    {
      notes.length > 0 && (
        <ul class="notes">
          {notes.map((note) => (
            <li>
              <time class="label" datetime={note.data.date.toISOString()}>
                {formatDate(note.data.date)}
              </time>
              <h2>
                <a href={url(`/notes/${note.id}/`)}>{note.data.title}</a>
              </h2>
              <p>{note.data.description}</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</Base>

<style>
  .notes {
    display: grid;
    gap: 2rem;
    margin-top: 2.5rem;
    list-style: none;
  }

  h2 {
    margin-block: 0.25rem;
    font-size: 1.5rem;
  }

  li p {
    color: var(--muted);
  }
</style>
